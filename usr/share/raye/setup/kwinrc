# KWin in the setup session: one full-screen window and nothing to wander
# off to. No hot corners, no overview, no window switcher, no desktop grid.
[ElectricBorders]
Bottom=None
BottomLeft=None
BottomRight=None
Left=None
Right=None
Top=None
TopLeft=None
TopRight=None

[TouchEdges]
Bottom=None
Left=None
Right=None
Top=None

[Effect-overview]
BorderActivate=9
TouchBorderActivate=9

[Plugins]
overviewEnabled=false
windowviewEnabled=false
desktopgridEnabled=false
screenedgeEnabled=false
shakecursorEnabled=false

[Wayland]
InputMethod[$e]=/usr/share/applications/org.kde.plasma.keyboard.desktop
VirtualKeyboardEnabled=false

[Windows]
Placement=Centered

[Xwayland]
Scale=1
