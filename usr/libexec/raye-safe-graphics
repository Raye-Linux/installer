#!/bin/sh
# Runs inside the new system, after the boot loader is in place.
#
# A person who could only start the install USB with its "Safe graphics"
# entry (nomodeset) has a graphics card whose driver can leave the screen
# black. The new system starts on the graphics ladder of raye-base
# (/etc/grub.d/09_raye_graphics) one level down: amdgpu.dc=0, the older
# display path of AMD cards, which keeps the real driver (full resolution,
# acceleration). If that start does not reach the desktop twice, the boot
# menu goes on to nomodeset by itself.
#
# The ladder needs GRUB to write its state on /boot (ext4 or FAT, which is
# what Raye's installer makes). Anywhere else nomodeset is kept for good, as
# before: a drop-in after 50-raye.cfg, then update-grub writes the menu again.
#
# A live session started without nomodeset changes nothing.

set -u
root=${RAYE_ROOT:-}
cmdline=${RAYE_CMDLINE:-/proc/cmdline}
dropin=$root/etc/default/grub.d/90-raye-safe-graphics.cfg

case " $(cat "$cmdline" 2>/dev/null) " in
    *" nomodeset "*) ;;
    *) exit 0 ;;
esac

fs=$(${RAYE_GRUB_PROBE:-grub-probe} --target=fs "$root/boot" 2>/dev/null || true)
case $fs in
ext2|ext3|ext4|fat)
    exec ${RAYE_GRUB_EDITENV:-grub-editenv} "$root/boot/grub/grubenv" set raye_gfx_level=1 raye_gfx_fails=0 ;;
esac

mkdir -p "${dropin%/*}" || exit 1
cat > "$dropin" <<'CFG' || exit 1
# Written by the installer: this computer was installed from the
# "Safe graphics" entry of the install USB, so it starts with nomodeset
# too. With a working graphics driver, delete this file and run
# "sudo update-grub".
case " $GRUB_CMDLINE_LINUX_DEFAULT " in
    *" nomodeset "*) ;;
    *) GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT nomodeset" ;;
esac
CFG
chmod 644 "$dropin"

${RAYE_UPDATE_GRUB:-update-grub}
